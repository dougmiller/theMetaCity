{% extends "blog/article_base.jinja2" %}

{% block title %}{{ article.title }}{% endblock %}
{% block includes %}
    <link rel="canonical" href="{{ url_for('blog.title', url=article.url) }}"/>
{% endblock %}

    <article>
        {% block body_content %}
            <h1><a href="{{ url_for('blog.title', url=article.url) }}">{{ article.title }}</a></h1>
        <h2>{{ article.dateline }}</h2>
        {% if article.parent.children %}
            <h3>Articles in this series:</h3>
            {{ other_blog_articles_list(article)|safe }}
        {% endif %}
        {{ article.content|safe }}
        <footer>
            <h2><a href="{{ url_for('blog.home') }}">Back to blog</a></h2>
        </footer>
    </article>
{% endblock %}

{% block licence %}"{{ article.title }}" by Douglas Miller is licensed under a <a rel="license" href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons Attribution-ShareAlike 4.0 International License.</a>.{% endblock %}
