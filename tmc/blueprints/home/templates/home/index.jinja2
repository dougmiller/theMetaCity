<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>The MetaCity.com</title>
        {% autoescape false %}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="{{ url_for('home.static', filename='css/style.css') }}"/>
        <link rel="icon" type="image/svg+xml" href="{{ url_for('home.static', filename='images/tmc-logo-animated.svg') }}">
        <link type="text/plain" rel="author" href="{{ url_for('home.static', filename='humans.txt') }}" />
        {% endautoescape %}
    </head>
    <body>
        <nav>
            <img alt="The MetaCity Logo" src="{{ url_for('home.static', filename='/images/tmc-logo-animated.svg') }}" width="160" height="160"/>
            <h1>theMetaCity.com</h1>
            <div>
                <a href="{{ url_for('blog.home') }}">Blog</a>
                <a href="{{ url_for('media.home') }}">Media</a>
            </div>
        </nav>
        <main>
        {% for article in articles %}
            <article class="{{ article.type }}">
                <h1>
                    {% if article.type == 'blog' %}
                        <a href="{{ url_for('blog.title', url=article.url) }}">{{ article.title }}</a>
                    {% else %}
                        {{ article.title }}
                    {% endif %}
                        
                </h1>
                <h2>{{ article.dateline }}</h2>
                <h3>Tags:
                {% for tag in article.tags %}
                    <a href="{{ url_for('blog.tags_tag', tag=tag.tag) }}">{{ tag.tag }}</a>
                    {% if not loop.last %}, {% endif %}
                {% endfor %}
                </h3>
            </article>
        {% endfor %}
        </main>
        <footer>
            <h3><a href="{{ url_for('home.sitemap') }}">Sitemap</a></h3>
            <h3><a href="https://assets.themetacity.com">Assets</a></h3>
            <h3><a href="https://github.com/dougmiller">GitHub</a></h3>
        </footer>
    </body>
</html>