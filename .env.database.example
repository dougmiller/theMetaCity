# Database connection config for Flask-SQLAlchemy-Lite (SQLALCHEMY_ENGINES).
# Two engines: `default` (read/write) and `read_only`. Passwords come from
# .pgpass (pgpasslib), not from here.

default.hostname = postgres
default.port = 5432
default.name = themetacity
default.user = tmc_master

read_only.hostname = postgres
read_only.port = 5432
read_only.name = themetacity
read_only.user = tmc_selector
