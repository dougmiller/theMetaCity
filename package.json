{
  "name": "themetacityflask",
  "version": "0.0.1",
  "description": "Build for the MetaCity main site",
  "private": true,
  "author": "Douglas Miller",
  "scripts": {
    "lint": "jshint theMetaCityFlask/static/javascript/*.js",
    "ts": "tsc typescript/*.ts",
    "css": "npm run css:fp & npm run css:main",
    "css:home": "npm run css:home:dev",
    "css:home:dev": "node PCSS-Home-Development.js",
    "css:home:prod": "node PCSS-Home-Production.js",
    "css:blog": "npm run css:blog:dev",
    "css:blog:dev": "node PCSS-Blog-Development.js",
    "css:blog:prod": "node PCSS-Blog-Production.js",
    "css:media": "npm run css:media:dev",
    "css:media:dev": "node PCSS-Media-Development.js",
    "css:media:prod": "node PCSS-Media-Production.js",
    "css:watch:blog": "watch 'npm run css:blog:dev' ./pcss",
    "deploy": "npm run deploy:local",
    "deploy:local": "node Deploy-local.js",
    "deploy:prod": "node Deploy-prod.js"
  },
  "dependencies": {
    "autoprefixer": "^9.7.3",
    "caniuse-lite": "^1.0.30001020",
    "chownr": "^1.1.3",
    "cssnano": "latest",
    "electron-to-chromium": "^1.3.332",
    "fs-extra": "latest",
    "jshint": "^2.11.0-rc1",
    "node-releases": "^1.1.45",
    "npm": "^6.13.6",
    "postcss": "^7.0.26",
    "postcss-css-variables": "^0.14.0",
    "postcss-custom-media": "latest",
    "postcss-discard-comments": "latest",
    "postcss-import": "latest",
    "postcss-import-part": "latest",
    "postcss-media-variables": "latest",
    "postcss-nested": "^4.2.1",
    "postcss-partial-import": "latest",
    "postcss-reporter": "latest",
    "typescript": "^3.7.4",
    "watch": "latest"
  },
  "devDependencies": {
    "postcss-map": "latest"
  }
}
