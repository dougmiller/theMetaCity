body {
    margin: 0 0 34em 0;

    > footer {
        height: calc(30em + 64px);
        padding-top: 4em;

        nav {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5em;

            a {
                font-family: var(--font-heading);
                color: var(--colour-glide);
                text-decoration: none;
                font-size: 1.8em;
                line-height: 2em;
            }
        }
    }
}